// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String?      @unique
  wallet     String?      @unique // one profile per wallet — linked when attendance is marked
  role       Role         @default(USER)
  createdAt  DateTime     @default(now())
  attendance Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String?
  wallet    String
  date      DateTime
  dateKey   String // UTC day (YYYY-MM-DD) — the uniqueness key for one-per-day
  hashProof String?
  user      User?    @relation(fields: [userId], references: [id])

  // One attendance record per wallet per UTC day. The DB enforces this
  // atomically, so two concurrent requests can't both insert.
  @@unique([wallet, dateKey])
}

enum Role {
  ADMIN
  USER
}
